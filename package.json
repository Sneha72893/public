{
  "name": "incident-response-automation",
  "version": "1.0.0",
  "description": "Atlassian Forge app for automated GitHub Actions incident response",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint src/ --ext .js",
    "test": "jest",
    "deploy": "forge deploy",
    "tunnel": "forge tunnel",
    "logs": "forge logs"
  },
  "dependencies": {
    "@forge/api": "^8.1.0",
    "@forge/events": "^3.0.6",
    "@forge/kvs": "^1.6.5",
    "@forge/resolver": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
